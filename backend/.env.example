# AI_MODE options:
# - mock: local deterministic demo parser; no remote inference
# - provider: remote OpenAI-compatible provider configured below
# - nvidia: legacy alias kept for backward compatibility
AI_MODE=mock

# Remote provider configuration. For NVIDIA/Kimi, the defaults below match the current setup.
AI_PROVIDER=nvidia
AI_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=moonshotai/kimi-k3

# Legacy variables are still supported as fallbacks so existing local .env files keep working:
# NVIDIA_API_KEY=
# NVIDIA_MODEL=moonshotai/kimi-k3

# Set a long random secret for multiple workers / stable preview tokens across restarts.
AI_SIGNING_SECRET=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
