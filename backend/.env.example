# Explicit opt-in demo parser; no remote inference. Use nvidia for real inference.
AI_MODE=mock
NVIDIA_API_KEY=
# In nvidia mode the assistant uses OpenAI-compatible function/tool calling.
# Choose a NVIDIA-hosted model that supports tools/function calling.
NVIDIA_MODEL=moonshotai/kimi-k3
# Set a long random secret for multiple workers / stable preview tokens across restarts.
AI_SIGNING_SECRET=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
